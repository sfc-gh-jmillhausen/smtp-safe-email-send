# Explicit setup input only. Never auto-loaded from a working directory.
# Replace these with your own values and absolute signature paths.
SAFE_EMAIL_ADDRESS=sender@example.com
SAFE_EMAIL_DISPLAY_NAME=Example Sender
SAFE_EMAIL_PROVIDER=gmail
SAFE_EMAIL_TIMEZONE=Etc/UTC
SAFE_EMAIL_SIGNATURE_TEXT_PATH=/absolute/path/to/private/signature.txt
SAFE_EMAIL_SIGNATURE_HTML_PATH=/absolute/path/to/private/signature.html
SAFE_EMAIL_CREDENTIAL_BACKEND=keychain
SAFE_EMAIL_MIN_INTERVAL_SECONDS=2
SAFE_EMAIL_MAX_MESSAGES_24H=1000
SAFE_EMAIL_MAX_RECIPIENTS_24H=1000
# Scheduled sends only run inside this window (local timezone). send-now ignores it.
SAFE_EMAIL_SEND_START_HOUR=8
SAFE_EMAIL_SEND_END_HOUR=17
SAFE_EMAIL_WEEKDAYS_ONLY=true
# Leave blank in files. Only inject into the PROCESS for credential_backend=env.
SAFE_EMAIL_APP_PASSWORD=
